{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ZerdeStudy — Web (localhost:3000)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--web-hostname",
        "localhost",
        "--web-port",
        "3000"
      ]
    },
    {
      "name": "ZerdeStudy — Windows",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "windows"]
    },
    {
      "name": "ZerdeStudy — Android",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "android"]
    }
  ]
}
